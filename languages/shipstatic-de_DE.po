msgstr ""
"Dateiweiser Upload (langsamer). Oben eine Ziel-URL festlegen, um das "
"schnelle Paket-Deployment zu aktivieren (PHP auf dem Host erforderlich)."

#: src/Support/I18n.php:333
msgid "Re-testing…"
msgstr "Teste erneut…"

#: src/Support/I18n.php:334
msgid "Re-test"
msgstr "Erneut testen"

#: src/Support/I18n.php:336
msgid "Deploy via"
msgstr "Bereitstellen über"

