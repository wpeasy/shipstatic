#, php-format
msgid "Blocked visitors go to the same page on %s."
msgstr "Los visitantes bloqueados van a la misma página en %s."

#: src/Support/I18n.php:218
msgid ""
"Blocked visitors see a 403 page (no destination has a Destination URL)."
msgstr ""
"Los visitantes bloqueados ven una página 403 (ningún destino tiene URL de "
