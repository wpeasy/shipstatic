msgstr "Aggiunto"

#: src/Support/I18n.php:204
msgid "Label, e.g. Office"
msgstr "Etichetta, ad es. Ufficio"

#: src/Support/I18n.php:205 src/Support/I18n.php:970
msgid "Add"
msgstr "Aggiungi"

#: src/Support/I18n.php:206 src/Support/I18n.php:720
msgid "Remove"
msgstr "Rimuovi"

#: src/Support/I18n.php:207
